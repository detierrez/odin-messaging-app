generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Session {
    id        String   @id
    sid       String   @unique
    data      String
    expiresAt DateTime
}

model User {
    id          Int     @id @default(autoincrement())
    username    String  @unique
    alias       String?
    avatarUrl   String?
    description String?

    sentRequests     Request[]       @relation("sentRequests")
    receivedRequests Request[]       @relation("receivedRequests")
    friendshipsA     Friendship[]    @relation("userFriendshipsA")
    friendshipsB     Friendship[]    @relation("userFriendshipsB")
    participations   Participation[] @relation("userParticipations")
    messages         Message[]       @relation("userMessages")
}

model Request {
    senderId   Int
    receiverId Int

    sender   User @relation("sentRequests", fields: [senderId], references: [id])
    receiver User @relation("receivedRequests", fields: [receiverId], references: [id])

    @@id([senderId, receiverId])
}

model Friendship {
    friendAId Int
    friendBId Int
    endedAt   DateTime?

    friendA User  @relation("userFriendshipsB", fields: [friendAId], references: [id])
    friendB User  @relation("userFriendshipsA", fields: [friendBId], references: [id])
    chat    Chat? @relation("directChat")

    @@id([friendAId, friendBId])
}

model Group {
    id          Int     @id @default(autoincrement())
    name        String?
    avatarUrl   String?
    description String?
    chatId      Int

    participations Participation[] @relation("groupParticipations")
    chat           Chat?           @relation("groupChat")
}

model Participation {
    userId  Int
    groupId Int
    role    Role      @default(MEMBER)
    endedAt DateTime?

    user  User  @relation("userParticipations", fields: [userId], references: [id], onDelete: Cascade)
    group Group @relation("groupParticipations", fields: [groupId], references: [id], onDelete: Cascade)

    @@id([userId, groupId])
}

model Chat {
    id        Int  @id @default(autoincrement())
    friendAId Int?
    friendBId Int?
    groupId   Int? @unique

    friendship Friendship? @relation("directChat", fields: [friendAId, friendBId], references: [friendAId, friendBId], onDelete: Cascade)
    group      Group?      @relation("groupChat", fields: [groupId], references: [id], onDelete: Cascade)
    messages   Message[]   @relation("chatMessages")

    @@unique([friendAId, friendBId])
}

model Message {
    id            Int         @id @default(autoincrement())
    chatId        Int
    userId        Int
    sentAt        DateTime    @default(now())
    type          MessageType @default(USER_MESSAGE)
    content       String?
    attachmentUrl String?
    metadata      Json?

    user User @relation("userMessages", fields: [userId], references: [id], onDelete: Cascade)
    chat Chat @relation("chatMessages", fields: [chatId], references: [id], onDelete: Cascade)
}

enum Role {
    MEMBER
    ADMIN
}

enum MessageType {
    USER_MESSAGE
    OPEN
    CLOSE
    JOIN
    LEAVE
    ROLE_UPDATE
    PROFILE_UPDATE
}
