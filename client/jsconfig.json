{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@contexts": ["contexts/index.js"],
      "@hooks": ["hooks/index.js"],
      "@lib/*": ["lib/*"],
      "@providers": ["providers/index.js"],
      "@styles/*": ["styles/*"],
      "@utils/*": ["utils/*"],
      "@icons/*": ["lib/icons/*"],
      "@images/*": ["lib/images/*"]
    }
  },
  "include": ["src/**/*"]
}
